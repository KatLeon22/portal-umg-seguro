# Copie a .env (chmod 600) o, mejor, ejecute: python scripts/generar_secretos.py
# Los valores reales NUNCA se versionan. En producción provienen de Vault.
FLASK_SECRET_KEY=<cadena aleatoria de 48+ caracteres>
DATA_ENC_KEYS=v1:<32 bytes aleatorios en Base64>
BLIND_INDEX_KEY=<32 bytes aleatorios en Base64>
DATABASE_URL=sqlite:///instance/portal.db
REPORT_DIR=instance/reportes
LOG_PATH=instance/seguridad.log
LAB_MODE=1
# --- Alternativa con HashiCorp Vault (AppRole) ---
# SECRETS_BACKEND=vault
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_ROLE_ID=<entregado por el despliegue>
# VAULT_SECRET_ID=<entregado por el despliegue, un solo uso>
