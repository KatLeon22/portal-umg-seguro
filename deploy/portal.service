# systemd: el portal corre con un usuario de servicio sin privilegios
[Unit]
Description=Portal Académico (laboratorio MASI)
After=network.target

[Service]
User=portal
Group=portal
WorkingDirectory=/opt/portal-umg
# Archivo de entorno: propietario root, grupo portal, permisos 0640 (no legible por otros usuarios)
EnvironmentFile=/etc/portal-umg/portal.env
ExecStart=/opt/portal-umg/.venv/bin/python run.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/portal-umg/instance
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
